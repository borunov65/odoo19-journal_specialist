<odoo>
    <record id="view_partner_form_journal" model="ir.ui.view">
        <field name="name">res.partner.form.journal</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Specialist Journal">

                    <!-- КНОПКА ДРУКУ -->
                    <header>
                        <button name="print_journal_report"
                                string="Print Journal Report"
                                type="object"
                                class="btn-primary"/>
                    </header>

                    <!-- JOURNAL ENTRIES -->
                    <field name="journal_entry_ids">
                        <list editable="bottom">
                            <field name="date"/>
                            <field name="user_id" readonly="1"/>
                            <field name="text"/>
                        </list>
                    </field>

                </page>
            </xpath>
        </field>
    </record>
</odoo>

