<odoo>
    <record id="view_journal_template_tree" model="ir.ui.view">
        <field name="name">journal.template.tree</field>
        <field name="model">specialist.journal.template</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_journal_template_form" model="ir.ui.view">
        <field name="name">journal.template.form</field>
        <field name="model">specialist.journal.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="content"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
