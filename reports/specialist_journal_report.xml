<odoo>
    <template id="report_specialist_journal">
        <t t-call="web.basic_layout">
            <t t-set="doc" t-value="docs[0]"/>
            <h2>
                Journal Entries Report for <t t-esc="docs[0].partner_id.name"/>
            </h2>
            <table class="table table-sm mt16">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Specialist</th>
                        <th>Note</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="docs" t-as="entry">
                        <tr>
                            <td><t t-esc="entry.date"/></td>
                            <td><t t-esc="entry.user_id.name"/></td>
                            <td><t t-esc="entry.text"/></td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </t>
    </template>
</odoo>
